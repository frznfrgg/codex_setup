{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/bash-guard/src/bash_guard.bin\"",
            "timeout": 3,
            "statusMessage": "Loading runtime context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/bash-guard/src/bash_guard.bin\"",
            "timeout": 3,
            "statusMessage": "Loading subagent context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/bash-guard/src/bash_guard.bin\"",
            "timeout": 10,
            "statusMessage": "Checking Bash safety"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/bash-guard/src/bash_guard.bin\"",
            "timeout": 3,
            "statusMessage": "Checking risk approval"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/bash-guard/src/bash_guard.bin\"",
            "timeout": 3,
            "statusMessage": "Handling subagent stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/bash-guard/src/bash_guard.bin\"",
            "timeout": 3,
            "statusMessage": "Handling turn stop"
          }
        ]
      }
    ]
  }
}
